# Not a secret — EXPO_PUBLIC_* vars are inlined into the client bundle at
# build time. Points at the tour-calendar backend (see @/lib/api.ts).
# For local dev against `next dev`, override with e.g.:
#   EXPO_PUBLIC_API_URL=http://<your-lan-ip>:3000 npm start
EXPO_PUBLIC_API_URL=https://woodshedd.com

# GitHub's push protection blocks committing a real Mapbox token even
# though "pk." ones are meant for client bundles — it's still billable
# against the account if scraped from a public repo, so set the real
# value in .env.local (gitignored) instead, e.g.:
#   EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-token-here
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
