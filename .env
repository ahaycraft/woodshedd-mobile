# Not a secret — EXPO_PUBLIC_* vars are inlined into the client bundle at
# build time. Points at the tour-calendar backend (see @/lib/api.ts).
# For local dev against `next dev`, override with e.g.:
#   EXPO_PUBLIC_API_URL=http://<your-lan-ip>:3000 npm start
EXPO_PUBLIC_API_URL=https://woodshedd.com
