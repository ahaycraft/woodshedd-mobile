{
  "expo": {
    "name": "woodshedd_mobile",
    "slug": "woodshedd_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "woodsheddmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ahaycraft.woodshedd-mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ahaycraft.woodsheddmobile",
      "adaptiveIcon": {
        "backgroundColor": "#100D0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100D0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Woodshedd uses this to add shows and practices to your calendar.",
          "writeOnlyAccess": true,
          "remindersPermission": false
        }
      ],
      "./plugins/withUISceneLifecycle",
      "@rnmapbox/maps",
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f0c577c-93f1-4f6e-a3e5-26ccafe574ca"
      }
    },
    "owner": "ahaycraft"
  }
}
